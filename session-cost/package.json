{
  "name": "@local/session-cost",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "Estimated session cost from provider-reported token usage, shown beside the composer and split per API key",
  "scripts": {
    "test": "node test/cost.test.mjs && node test/client.test.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "test",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
